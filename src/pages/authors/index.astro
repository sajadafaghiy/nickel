---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const authors = (await getCollection('authors'))
  .sort((a, b) => a.data.name.localeCompare(b.data.name, 'fa'));
const books = await getCollection('books', ({ data }) => !data.draft);
const bookCounts = new Map<string, number>();

for (const book of books) {
  for (const author of book.data.authors) {
    bookCounts.set(author.id, (bookCounts.get(author.id) ?? 0) + 1);
  }
}
---

<BaseLayout title="نویسندگان | نیکل" description="فهرست الفبایی نویسندگان کتاب‌های نیکل">
  <header class="tag-header">
    <div class="container">
      <a class="back-link" href={import.meta.env.BASE_URL}>
        <span class="link-chevron" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m10 7 5 5-5 5"></path></svg></span>
        <span>بازگشت به صفحهٔ اصلی</span>
      </a>
      <span class="eyebrow">نویسندگان</span>
      <h1>همهٔ نویسندگان</h1>
      <p>{authors.length.toLocaleString('fa-IR')} نویسنده</p>
    </div>
  </header>

  <section class="section" aria-labelledby="authors-heading">
    <div class="container">
      <h2 class="sr-only" id="authors-heading">فهرست الفبایی نویسندگان</h2>
      <ul class="tags-index">
        {authors.map((author) => (
          <li>
            <a href={`${import.meta.env.BASE_URL}authors/${author.id}/`}>
              <span>{author.data.name}</span>
              <small>{(bookCounts.get(author.id) ?? 0).toLocaleString('fa-IR')} کتاب</small>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>