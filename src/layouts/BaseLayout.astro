---
import { getCollection } from 'astro:content';
import globalStyles from '../styles/global.css?inline';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'نیکل | خلاصهٔ کتاب به فارسی',
  description = 'خلاصه‌های کوتاه و خواندنی از کتاب‌های ارزشمند به زبان فارسی',
} = Astro.props;

const books = (await getCollection('books', ({ data }) => !data.draft))
  .sort((a, b) => a.data.title.localeCompare(b.data.title, 'fa'));
const authors = await getCollection('authors');
const authorNames = new Map(authors.map((author) => [author.id, author.data.name]));
const currentPath = Astro.url.pathname;
const isHomePage = currentPath === import.meta.env.BASE_URL;
const authorsHref = `${import.meta.env.BASE_URL}authors/`;
const tagsHref = `${import.meta.env.BASE_URL}tags/`;

const searchableText = (book: (typeof books)[number]) => [
  book.data.title,
  ...book.data.authors.map((author) => authorNames.get(author.id) ?? author.id),
  ...book.data.tags,
  book.data.description,
  book.body,
].join(' ');
---

<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#173f35" />
    <meta name="application-name" content="نیکل" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="نیکل" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}pwa-192.svg`} />
    <link rel="manifest" href={`${import.meta.env.BASE_URL}manifest.webmanifest`} />
    <style is:inline set:html={globalStyles}></style>
    <script is:inline>
      (() => {
        const savedTheme = localStorage.getItem('theme');
        const theme = savedTheme === 'light' || savedTheme === 'dark'
          ? savedTheme
          : matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={import.meta.env.BASE_URL} aria-label="صفحهٔ اصلی نیکل">
          <span class="brand-mark" aria-hidden="true">ن</span>
          <span>نیکل</span>
        </a>
        <div class="header-actions">
          <div class="header-search">
            <label class="search-field">
              <span class="sr-only">جست‌وجو در همهٔ متن کتاب‌ها</span>
              <span aria-hidden="true">⌕</span>
              <input id="book-search" type="search" placeholder="جست‌وجو در کتاب‌ها …" autocomplete="off" aria-controls="search-results" />
            </label>
            <div class="search-results" id="search-results" hidden>
              <p class="search-status" id="search-status"></p>
              <ul id="search-result-list"></ul>
            </div>
          </div>
          <button class="theme-toggle" id="theme-toggle" type="button" aria-label="فعال‌کردن حالت تیره" title="تغییر پوسته">
            <svg class="theme-icon theme-icon-sun" aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"></path></svg>
            <svg class="theme-icon theme-icon-moon" aria-hidden="true" viewBox="0 0 24 24"><path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5 8.5 8.5 0 1 0 20.5 14.2Z"></path></svg>
          </button>
        </div>
      </div>
    </header>
    <div class="site-body">
      <aside class="sidebar">
        <nav aria-label="پیمایش کتاب‌ها و برچسب‌ها">
          <details class="books-menu">
            <summary>
              <span class="books-menu-label">
                <span class="books-menu-icon" aria-hidden="true">☰</span>
                <span>کتاب‌ها</span>
              </span>
              <span class="books-menu-meta">
                <small>{books.length.toLocaleString('fa-IR')}</small>
                <span class="books-menu-chevron" aria-hidden="true">
                  <svg viewBox="0 0 24 24">
                    <path d="m7 10 5 5 5-5"></path>
                  </svg>
                </span>
              </span>
            </summary>
            <button class="books-menu-backdrop" type="button" aria-label="بستن فهرست کتاب‌ها"></button>
            <div class="books-menu-panel">
              <ul class="sidebar-list" id="book-list">
                {books.map((book) => {
                  const href = `${import.meta.env.BASE_URL}books/${book.id}/`;
                  const authors = book.data.authors.map((author) => authorNames.get(author.id) ?? author.id).join(' و ');
                  return (
                    <li data-search={searchableText(book)} data-title={book.data.title} data-author={authors} data-href={href}>
                      <a href={href} aria-current={currentPath === href ? 'page' : undefined}>
                        <span>{book.data.title}</span>
                        <small>{authors}</small>
                      </a>
                    </li>
                  );
                })}
              </ul>
            </div>
          </details>
          <a class="sidebar-tags-link" href={authorsHref} aria-current={currentPath === authorsHref ? 'page' : undefined}>
            <span class="books-menu-icon" aria-hidden="true">✎</span>
            <span>همهٔ نویسندگان</span>
          </a>
          <a class="sidebar-tags-link" href={tagsHref} aria-current={currentPath === tagsHref ? 'page' : undefined}>
            <span class="books-menu-icon" aria-hidden="true">#</span>
            <span>همهٔ برچسب‌ها</span>
          </a>
        </nav>
      </aside>
      <main class="site-main"><slot /></main>
    </div>
    {isHomePage && (
      <aside class="continue-reading" id="continue-reading" aria-label="ادامهٔ مطالعه" hidden>
        <div class="continue-reading-copy">
          <span>ادامهٔ مطالعه</span>
          <strong id="continue-reading-title"></strong>
          <small id="continue-reading-progress"></small>
        </div>
        <a class="continue-reading-link" id="continue-reading-link" href="#">ادامه بده</a>
        <button class="continue-reading-close" id="continue-reading-close" type="button" aria-label="بستن پیشنهاد ادامهٔ مطالعه">×</button>
      </aside>
    )}
    <footer class="site-footer">
      <div class="container">با علاقه به کتاب و یادگیری ساخته شده است.</div>
    </footer>
    <script>
      if ('serviceWorker' in navigator) {
        addEventListener('load', () => {
          navigator.serviceWorker.register(`${import.meta.env.BASE_URL}sw.js`, {
            scope: import.meta.env.BASE_URL,
          });
        });
      }

      const themeToggle = document.querySelector<HTMLButtonElement>('#theme-toggle');
      const booksMenu = document.querySelector<HTMLDetailsElement>('.books-menu');
      const booksMenuBackdrop = document.querySelector<HTMLButtonElement>('.books-menu-backdrop');
      const input = document.querySelector<HTMLInputElement>('#book-search');
      const items = [...document.querySelectorAll<HTMLElement>('#book-list > li')];
      const results = document.querySelector<HTMLElement>('#search-results');
      const resultList = document.querySelector<HTMLUListElement>('#search-result-list');
      const status = document.querySelector<HTMLElement>('#search-status');
      const continueReading = document.querySelector<HTMLElement>('#continue-reading');
      const continueTitle = document.querySelector<HTMLElement>('#continue-reading-title');
      const continueProgress = document.querySelector<HTMLElement>('#continue-reading-progress');
      const continueLink = document.querySelector<HTMLAnchorElement>('#continue-reading-link');
      const continueClose = document.querySelector<HTMLButtonElement>('#continue-reading-close');

      type ReadingProgress = {
        id?: string;
        title?: string;
        url?: string;
        scrollY?: number;
        progress?: number;
        updatedAt?: number;
      };

      const readingStorageKey = 'nickel:last-read-book';
      const currentBookId = document.querySelector<HTMLElement>('[data-book-page]')?.dataset.bookId;

      try {
        const saved = localStorage.getItem(readingStorageKey);
        const reading = saved ? JSON.parse(saved) as ReadingProgress : null;
        if (reading && typeof reading.progress === 'number' && reading.progress >= 0.98) {
          localStorage.removeItem(readingStorageKey);
        } else if (reading?.id && reading.title && reading.url && reading.id !== currentBookId && continueReading && continueTitle && continueLink) {
          continueTitle.textContent = reading.title;
          continueLink.href = reading.url;
          if (continueProgress && typeof reading.progress === 'number') {
            const percent = Math.round(reading.progress * 100);
            continueProgress.textContent = percent > 2 ? `${percent.toLocaleString('fa-IR')}٪ خوانده شده` : 'از ابتدای کتاب';
          }
          continueReading.hidden = false;
        }
      } catch {
        localStorage.removeItem(readingStorageKey);
      }

      continueLink?.addEventListener('click', () => {
        const saved = localStorage.getItem(readingStorageKey);
        if (!saved) return;
        try {
          const reading = JSON.parse(saved) as ReadingProgress;
          sessionStorage.setItem('nickel:restore-scroll', JSON.stringify({ id: reading.id, scrollY: reading.scrollY ?? 0 }));
        } catch {
          localStorage.removeItem(readingStorageKey);
        }
      });

      continueClose?.addEventListener('click', () => {
        localStorage.removeItem(readingStorageKey);
        sessionStorage.removeItem('nickel:restore-scroll');
        if (continueReading) continueReading.remove();
      });

      const pendingRestore = sessionStorage.getItem('nickel:restore-scroll');
      if (pendingRestore && currentBookId) {
        try {
          const restore = JSON.parse(pendingRestore) as { id?: string; scrollY?: number };
          if (restore.id === currentBookId) {
            sessionStorage.removeItem('nickel:restore-scroll');
            requestAnimationFrame(() => window.scrollTo({ top: restore.scrollY ?? 0, behavior: 'instant' }));
          }
        } catch {
          sessionStorage.removeItem('nickel:restore-scroll');
        }
      }

      const updateThemeButton = () => {
        if (!themeToggle) return;
        const isDark = document.documentElement.dataset.theme === 'dark';
        themeToggle.setAttribute('aria-label', isDark ? 'فعال‌کردن حالت روشن' : 'فعال‌کردن حالت تیره');
        themeToggle.setAttribute('aria-pressed', String(isDark));
      };

      updateThemeButton();
      themeToggle?.addEventListener('click', () => {
        const nextTheme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = nextTheme;
        localStorage.setItem('theme', nextTheme);
        updateThemeButton();
      });

      booksMenuBackdrop?.addEventListener('click', () => {
        if (booksMenu) booksMenu.open = false;
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && booksMenu?.open) {
          booksMenu.open = false;
          booksMenu.querySelector<HTMLElement>('summary')?.focus();
        }
      });

      const normalize = (value: string) => value
        .toLocaleLowerCase('fa')
        .replace(/[يى]/g, 'ی')
        .replace(/ك/g, 'ک')
        .replace(/[\u064B-\u065F\u0670]/g, '')
        .trim();

      const plainText = (value: string) => value
        .replace(/^---[\s\S]*?---/, '')
        .replace(/[#>*_`[\]()!-]/g, ' ')
        .replace(/\s+/g, ' ')
        .trim();

      const makePreview = (text: string, query: string) => {
        const clean = plainText(text);
        const index = normalize(clean).indexOf(query);
        if (index < 0) return clean.slice(0, 130);
        const start = Math.max(0, index - 55);
        const end = Math.min(clean.length, index + query.length + 85);
        return `${start ? '…' : ''}${clean.slice(start, end)}${end < clean.length ? '…' : ''}`;
      };

      input?.addEventListener('input', () => {
        const query = normalize(input.value);
        if (!results || !resultList || !status) return;
        resultList.replaceChildren();

        if (!query) {
          results.hidden = true;
          return;
        }

        const matches = items.filter((item) => normalize(item.dataset.search ?? '').includes(query));
        status.textContent = matches.length ? `${matches.length.toLocaleString('fa-IR')} نتیجه` : 'نتیجه‌ای پیدا نشد.';

        for (const item of matches) {
          const link = document.createElement('a');
          const title = document.createElement('strong');
          const author = document.createElement('small');
          const preview = document.createElement('p');
          const listItem = document.createElement('li');
          link.href = item.dataset.href ?? '#';
          title.textContent = item.dataset.title ?? '';
          author.textContent = item.dataset.author ?? '';
          preview.textContent = makePreview(item.dataset.search ?? '', query);
          link.append(title, author, preview);
          listItem.append(link);
          resultList.append(listItem);
        }
        results.hidden = false;
      });

      document.addEventListener('click', (event) => {
        if (results && !event.composedPath().some((node) => node instanceof Element && node.closest?.('.header-search'))) {
          results.hidden = true;
        }
      });
    </script>
  </body>
</html>
