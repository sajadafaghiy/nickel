---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getReadingTime } from '../../utils/readingTime';

export const getStaticPaths = (async () => {
  const books = await getCollection('books', ({ data }) => !data.draft);
  const tags = [...new Set(books.flatMap((book) => book.data.tags))];

  return tags.map((tag) => ({ params: { tag }, props: { tag } }));
}) satisfies GetStaticPaths;

const { tag } = Astro.props;
const books = (await getCollection('books', ({ data }) => !data.draft && data.tags.includes(tag)))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const authors = await getCollection('authors');
const authorNames = new Map(authors.map((author) => [author.id, author.data.name]));
const formatter = new Intl.DateTimeFormat('fa-IR', { day: 'numeric', month: 'long', year: 'numeric' });
const tagHref = (value: string) => `${import.meta.env.BASE_URL}tags/${encodeURIComponent(value)}/`;
---

<BaseLayout title={`${tag} | نیکل`} description={`همهٔ خلاصه‌کتاب‌های دارای برچسب ${tag}`}>
  <header class="tag-header">
    <div class="container">
      <a class="back-link" href={import.meta.env.BASE_URL}>
        <span class="link-chevron" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m10 7 5 5-5 5"></path></svg></span>
        <span>بازگشت به همهٔ خلاصه‌ها</span>
      </a>
      <span class="eyebrow">برچسب</span>
      <h1>{tag}</h1>
      <p>{books.length.toLocaleString('fa-IR')} کتاب با این برچسب</p>
    </div>
  </header>

  <section class="section" aria-labelledby="tag-books-heading">
    <div class="container">
      <h2 class="sr-only" id="tag-books-heading">کتاب‌های دارای برچسب {tag}</h2>
      <div class="books-grid">
        {books.map((book) => (
          <article class="book-card">
            <div class="card-top">
              <time class="date" datetime={book.data.publishedAt.toISOString()}>{formatter.format(book.data.publishedAt)}</time>
            </div>
            <h3><a href={`${import.meta.env.BASE_URL}books/${book.id}/`}>{book.data.emoji} {book.data.title}</a></h3>
            <span class="author">
              {book.data.authors.map((author, index) => (
                <>{index > 0 && ' و '}<a href={`${import.meta.env.BASE_URL}authors/${author.id}/`}>{authorNames.get(author.id) ?? author.id}</a></>
              ))}
            </span>
            <p class="description">{book.data.description}</p>
            <div class="tags card-tags" aria-label="برچسب‌ها">
              {book.data.tags.map((bookTag) => (
                <a class="tag" href={tagHref(bookTag)} aria-current={bookTag === tag ? 'page' : undefined}>{bookTag}</a>
              ))}
            </div>
            <div class="card-footer">
              <span>{getReadingTime(book.body ?? '')} مطالعه</span>
              <a class="read-more" href={`${import.meta.env.BASE_URL}books/${book.id}/`}>
                <span>مطالعهٔ خلاصه</span>
                <span class="link-chevron" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m14 7-5 5 5 5"></path></svg></span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>