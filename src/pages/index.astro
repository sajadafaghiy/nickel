---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getReadingTime } from '../utils/readingTime';

const books = (await getCollection('books', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const featuredBooks = books.filter(({ data }) => data.featured);

const formatter = new Intl.DateTimeFormat('fa-IR', { day: 'numeric', month: 'long', year: 'numeric' });
const tagHref = (tag: string) => `${import.meta.env.BASE_URL}tags/${encodeURIComponent(tag)}/`;
---

<BaseLayout>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <span class="eyebrow">خواندن، اندیشیدن، به خاطر سپردن</span>
        <h1>جوهرهٔ کتاب‌ها،<br />ساده و خواندنی.</h1>
        <p class="hero-copy">اینجا ایده‌های اصلی کتاب‌های ارزشمند را در خلاصه‌هایی دقیق و روان می‌خوانیم؛ برای وقتی که می‌خواهید بهتر انتخاب کنید، مرور کنید یا چیزی تازه یاد بگیرید.</p>
      </div>
      <div class="hero-art" aria-hidden="true"><div class="book-shape"></div></div>
    </div>
  </section>

  {featuredBooks.length > 0 && (
    <section class="section featured-section" aria-labelledby="featured-heading">
      <div class="container">
        <div class="section-heading featured-heading">
          <div>
            <span class="eyebrow">پیشنهاد نیکل</span>
            <h2 id="featured-heading">خلاصه‌های منتخب</h2>
          </div>
          <div class="featured-heading-actions">
            <p>برای شروع این کتاب‌ها را پیشنهاد می‌کنیم</p>
            {featuredBooks.length > 0 && (
              <div class="carousel-controls" aria-label="کنترل‌های اسلاید خلاصه‌های منتخب">
                <button class="carousel-button" type="button" data-carousel-prev aria-label="اسلاید قبلی">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
                </button>
                <span class="carousel-status" data-carousel-status aria-live="polite"></span>
                <button class="carousel-button" type="button" data-carousel-next aria-label="اسلاید بعدی">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg>
                </button>
              </div>
            )}
          </div>
        </div>
        <div class="featured-carousel" data-carousel tabindex="0" role="region" aria-label="خلاصه‌های منتخب؛ برای پیمایش بکشید یا از کلیدهای جهت‌نما استفاده کنید">
          <div class="featured-track" data-carousel-track>
            {featuredBooks.map((book, index) => (
              <article class="book-card featured-card" aria-label={`${index + 1} از ${featuredBooks.length}`}>
              <div class="card-top">
                <span class="featured-badge">منتخب</span>
                <time class="date" datetime={book.data.publishedAt.toISOString()}>{formatter.format(book.data.publishedAt)}</time>
              </div>
              <h3><a href={`${import.meta.env.BASE_URL}books/${book.id}/`}>{book.data.title}</a></h3>
              <span class="author">{book.data.author}</span>
              <p class="description">{book.data.description}</p>
              <div class="tags card-tags" aria-label="برچسب‌ها">
                {book.data.tags.map((tag) => <a class="tag" href={tagHref(tag)}>{tag}</a>)}
              </div>
              <div class="card-footer">
                <span>{getReadingTime(book.body ?? '')} مطالعه</span>
                <a class="read-more" href={`${import.meta.env.BASE_URL}books/${book.id}/`}>
                  <span>مطالعهٔ خلاصه</span>
                  <span class="link-chevron" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m14 7-5 5 5 5"></path></svg></span>
                </a>
              </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}

  <section class="section books-section" aria-labelledby="books-heading">
    <div class="container">
      <div class="section-heading">
        <h2 id="books-heading">تازه‌ترین خلاصه‌ها</h2>
        <p>{books.length.toLocaleString('fa-IR')} کتاب برای کشف کردن</p>
      </div>
      <div class="books-grid">
        {books.map((book) => (
          <article class="book-card">
            <div class="card-top">
              <time class="date" datetime={book.data.publishedAt.toISOString()}>{formatter.format(book.data.publishedAt)}</time>
            </div>
            <h3><a href={`${import.meta.env.BASE_URL}books/${book.id}/`}>{book.data.title}</a></h3>
            <span class="author">{book.data.author}</span>
            <p class="description">{book.data.description}</p>
            <div class="tags card-tags" aria-label="برچسب‌ها">
              {book.data.tags.map((tag) => <a class="tag" href={tagHref(tag)}>{tag}</a>)}
            </div>
            <div class="card-footer">
              <span>{getReadingTime(book.body ?? '')} مطالعه</span>
              <a class="read-more" href={`${import.meta.env.BASE_URL}books/${book.id}/`}>
                <span>مطالعهٔ خلاصه</span>
                <span class="link-chevron" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m14 7-5 5 5 5"></path></svg></span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const carousel = document.querySelector<HTMLElement>('[data-carousel]');
  const track = carousel?.querySelector<HTMLElement>('[data-carousel-track]');
  const cards = track ? [...track.querySelectorAll<HTMLElement>('.featured-card')] : [];
  const previousButton = document.querySelector<HTMLButtonElement>('[data-carousel-prev]');
  const nextButton = document.querySelector<HTMLButtonElement>('[data-carousel-next]');
  const status = document.querySelector<HTMLElement>('[data-carousel-status]');
  let currentPage = 0;
  let autoplayTimer: number | undefined;
  let pointerStartX = 0;
  let pointerOffset = 0;
  let activePointer: number | undefined;
  let isDragging = false;

  const cardsPerView = () => window.innerWidth <= 560 ? 1 : window.innerWidth <= 800 ? 2 : 3;
  const pageCount = () => Math.max(1, Math.ceil(cards.length / cardsPerView()));

  const renderCarousel = () => {
    if (!track || !cards.length) return;
    currentPage = Math.min(currentPage, pageCount() - 1);
    track.style.setProperty('--carousel-page', String(currentPage));
    if (previousButton) previousButton.disabled = currentPage === 0;
    if (nextButton) nextButton.disabled = currentPage === pageCount() - 1;
    if (status) status.textContent = `${(currentPage + 1).toLocaleString('fa-IR')} / ${pageCount().toLocaleString('fa-IR')}`;
  };

  const stopAutoplay = () => {
    window.clearInterval(autoplayTimer);
    autoplayTimer = undefined;
  };

  const startAutoplay = () => {
    stopAutoplay();
    if (pageCount() <= 1 || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    autoplayTimer = window.setInterval(() => {
      currentPage = (currentPage + 1) % pageCount();
      renderCarousel();
    }, 5000);
  };

  previousButton?.addEventListener('click', () => {
    currentPage = Math.max(0, currentPage - 1);
    renderCarousel();
    startAutoplay();
  });
  nextButton?.addEventListener('click', () => {
    currentPage = Math.min(pageCount() - 1, currentPage + 1);
    renderCarousel();
    startAutoplay();
  });
  const moveBy = (amount: number) => {
    currentPage = Math.max(0, Math.min(pageCount() - 1, currentPage + amount));
    renderCarousel();
    startAutoplay();
  };

  carousel?.addEventListener('pointerdown', (event) => {
    if (event.pointerType === 'mouse' && event.button !== 0) return;
    activePointer = event.pointerId;
    pointerStartX = event.clientX;
    pointerOffset = 0;
    isDragging = false;
    stopAutoplay();
  });
  carousel?.addEventListener('pointermove', (event) => {
    if (activePointer !== event.pointerId || !track) return;
    pointerOffset = event.clientX - pointerStartX;
    if (!isDragging && Math.abs(pointerOffset) < 8) return;
    if (!isDragging) {
      isDragging = true;
      carousel.setPointerCapture(event.pointerId);
      carousel.classList.add('is-dragging');
    }
    track.style.setProperty('--carousel-drag', `${pointerOffset}px`);
  });
  const finishDrag = (event: PointerEvent) => {
    if (activePointer !== event.pointerId || !carousel || !track) return;
    if (Math.abs(pointerOffset) > Math.min(80, carousel.clientWidth * .12)) {
      currentPage = Math.max(0, Math.min(pageCount() - 1, currentPage + (pointerOffset > 0 ? 1 : -1)));
    }
    activePointer = undefined;
    pointerOffset = 0;
    isDragging = false;
    track.style.setProperty('--carousel-drag', '0px');
    carousel.classList.remove('is-dragging');
    renderCarousel();
    startAutoplay();
  };
  carousel?.addEventListener('pointerup', finishDrag);
  carousel?.addEventListener('pointercancel', finishDrag);
  carousel?.addEventListener('wheel', (event) => {
    if (Math.abs(event.deltaX) <= Math.abs(event.deltaY) || Math.abs(event.deltaX) < 20) return;
    event.preventDefault();
    moveBy(event.deltaX < 0 ? 1 : -1);
  }, { passive: false });
  carousel?.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowLeft') moveBy(1);
    else if (event.key === 'ArrowRight') moveBy(-1);
    else return;
    event.preventDefault();
  });
  carousel?.addEventListener('mouseenter', stopAutoplay);
  carousel?.addEventListener('mouseleave', startAutoplay);
  carousel?.addEventListener('focusin', stopAutoplay);
  carousel?.addEventListener('focusout', (event) => {
    if (!carousel.contains(event.relatedTarget as Node | null)) startAutoplay();
  });
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) stopAutoplay();
    else startAutoplay();
  });
  window.addEventListener('resize', () => {
    renderCarousel();
    startAutoplay();
  });
  renderCarousel();
  startAutoplay();
</script>
